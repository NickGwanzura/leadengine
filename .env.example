# Copy to .env for Compose, or enter these in Dokploy's Environment panel.
# Use URL-safe random secrets, e.g. openssl rand -hex 32, separately for each.
POSTGRES_USER=leados
POSTGRES_DB=leados
POSTGRES_PASSWORD=
REDIS_PASSWORD=
AUTH_SECRET=
INTERNAL_API_SECRET=
AI_PROVIDER=openai-compatible
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4.1-mini
# Optional model override for public web Lead Discovery (must support web_search).
AI_DISCOVERY_MODEL=
AUTH_URL=http://localhost:3000
NEON_DATABASE_URL=
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Only for running Next.js/Prisma outside Compose; use a Neon URL if preferred.
DATABASE_URL=postgresql://leados:REPLACE@localhost:5432/leados?schema=public
REDIS_URL=redis://:REPLACE@localhost:6379
