generator client {
 provider = "prisma-client-js"
}
datasource db {
 provider = "postgresql"
 url = env("DATABASE_URL")
}
model Organization {
 id String @id @default(cuid())
 name String
 members OrganizationMember[]
 companies ProspectCompany[]
 imports ImportBatch[]
 logs AuditLog[]
 packages ProductPackage[]
 followUpTasks FollowUpTask[]
 outreachDrafts OutreachDraft[]
 proposals Proposal[]
 discoveryCandidates DiscoveryCandidate[]
 discoveryRuns DiscoverySearchRun[]
 businessProfile BusinessProfile?
 outreachSends OutreachSend[]
 emailSuppressions EmailSuppression[]
 createdAt DateTime @default(now())
}
model User {
 id String @id @default(cuid())
 email String @unique
 name String
 passwordHash String
 memberships OrganizationMember[]
 createdFollowUpTasks FollowUpTask[] @relation("FollowUpTaskCreator")
 assignedFollowUpTasks FollowUpTask[] @relation("FollowUpTaskAssignee")
 createdOutreachDrafts OutreachDraft[]
 outreachSends OutreachSend[]
 createdProposals Proposal[]
}
model OrganizationMember {
 id String @id @default(cuid())
 organizationId String
 userId String
 role String @default("MEMBER")
 organization Organization @relation(fields:[organizationId],references:[id])
 user User @relation(fields:[userId],references:[id])
 @@unique([organizationId,userId])
}
model ProspectCompany {
 id String @id @default(cuid())
 organizationId String
 organization Organization @relation(fields:[organizationId],references:[id])
 name String
 domain String?
 website String?
 industry String @default("Unclassified")
 country String @default("Zimbabwe")
 city String @default("")
 email String?
 phone String?
 contactPerson String?
 contactPosition String?
 linkedinUrl String?
 facebookUrl String?
 sizeEstimate String?
 notes String @default("")
 source String @default("Manual")
 stage String @default("NEW LEAD")
 priority String @default("Normal")
 assignedProduct String?
 dealValue Decimal @default(0) @db.Decimal(14,2)
 probability Int @default(0)
 nextFollowUp DateTime?
 ownerId String?
 proposalStatus String @default("NONE")
 importBatchId String?
 importBatch ImportBatch? @relation(fields:[importBatchId],references:[id])
 score LeadScore?
 jobs CrawlJob[]
 audits WebsiteAudit[]
 activities DealActivity[]
 followUpTasks FollowUpTask[]
 outreachDrafts OutreachDraft[]
 outreachSends OutreachSend[]
 proposals Proposal[]
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 @@unique([organizationId,domain])
 @@index([organizationId,stage])
 @@index([organizationId,nextFollowUp])
}
model DiscoveryCandidate {
 id String @id @default(cuid())
 organizationId String
 organization Organization @relation(fields:[organizationId],references:[id],onDelete:Cascade)
 name String
 website String
 sourceUrl String
 description String
 industry String
 city String
 status String @default("NEW")
 segment String @default("")
 fitReason String @default("")
 discoveredAt DateTime @default(now())
 reviewedAt DateTime?
 @@unique([organizationId,website])
 @@index([organizationId,status,discoveredAt])
}
model DiscoverySearchRun {
 id String @id @default(cuid())
 organizationId String
 organization Organization @relation(fields:[organizationId],references:[id],onDelete:Cascade)
 sector String
 status String @default("RUNNING")
 resultCount Int @default(0)
 error String?
 startedAt DateTime @default(now())
 finishedAt DateTime?
 @@index([organizationId,sector,startedAt])
}
model ImportBatch {
 id String @id @default(cuid())
 organizationId String
 organization Organization @relation(fields:[organizationId],references:[id])
 createdAt DateTime @default(now())
 rolledBackAt DateTime?
 companies ProspectCompany[]
}
model CrawlJob {
 id String @id @default(cuid())
 companyId String
 company ProspectCompany @relation(fields:[companyId],references:[id],onDelete:Cascade)
 url String
 status String @default("QUEUED")
 progress Int @default(0)
 attempt Int @default(0)
 maxAttempts Int @default(3)
 approvedBy String
 approvedAt DateTime @default(now())
 approvedDomain String
 error String?
 availableAt DateTime @default(now())
 startedAt DateTime?
 finishedAt DateTime?
 leaseToken String?
 leaseExpiresAt DateTime?
 audit WebsiteAudit?
 createdAt DateTime @default(now())
 @@index([status,availableAt])
 @@index([companyId,status])
}
model CrawledPage {
 id String @id @default(cuid())
 auditId String
 audit WebsiteAudit @relation(fields:[auditId],references:[id],onDelete:Cascade)
 url String
 title String?
 statusCode Int
 metadata Json
 crawledAt DateTime @default(now())
 @@unique([auditId,url])
}
model WebsiteAudit {
 id String @id @default(cuid())
 companyId String
 company ProspectCompany @relation(fields:[companyId],references:[id],onDelete:Cascade)
 jobId String @unique
 job CrawlJob @relation(fields:[jobId],references:[id],onDelete:Cascade)
 summary String
 pages CrawledPage[]
 findings AuditFinding[]
 createdAt DateTime @default(now())
 @@index([companyId,createdAt])
}
model AuditFinding {
 id String @id @default(cuid())
 auditId String
 audit WebsiteAudit @relation(fields:[auditId],references:[id],onDelete:Cascade)
 category String
 classification String
 observation String
 recommendation String
 sourceUrl String
 evidence Json
 confidence Float
}
model LeadScore {
 id String @id @default(cuid())
 companyId String @unique
 company ProspectCompany @relation(fields:[companyId],references:[id],onDelete:Cascade)
 total Int @default(0)
 breakdown Json
 explanation String
 override Int?
 updatedAt DateTime @updatedAt
}
model DealActivity {
 id String @id @default(cuid())
 companyId String
 company ProspectCompany @relation(fields:[companyId],references:[id],onDelete:Cascade)
 userId String
 type String
 body String
 createdAt DateTime @default(now())
 @@index([companyId,createdAt])
}
model FollowUpTask {
 id String @id @default(cuid())
 organizationId String
 organization Organization @relation(fields:[organizationId],references:[id],onDelete:Cascade)
 companyId String?
 company ProspectCompany? @relation(fields:[companyId],references:[id],onDelete:SetNull)
 createdBy String
 creator User @relation("FollowUpTaskCreator",fields:[createdBy],references:[id])
 assignedTo String?
 assignee User? @relation("FollowUpTaskAssignee",fields:[assignedTo],references:[id])
 title String
 description String @default("")
 type String @default("GENERAL")
 dueAt DateTime
 status String @default("OPEN")
 completedAt DateTime?
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 @@index([organizationId,status,dueAt])
 @@index([companyId,status,dueAt])
}
model OutreachDraft {
 id String @id @default(cuid())
 organizationId String
 organization Organization @relation(fields:[organizationId],references:[id],onDelete:Cascade)
 companyId String
 company ProspectCompany @relation(fields:[companyId],references:[id],onDelete:Cascade)
 createdBy String
 creator User @relation(fields:[createdBy],references:[id])
 channel String
 purpose String
 subject String?
 body String
 facts Json
 assumptions Json
 provider String
 model String
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 @@index([organizationId,createdAt])
 @@index([companyId,createdAt])
 sends OutreachSend[]
}
model OutreachSend {
 id String @id @default(cuid())
 organizationId String
 organization Organization @relation(fields:[organizationId],references:[id],onDelete:Cascade)
 draftId String
 draft OutreachDraft @relation(fields:[draftId],references:[id],onDelete:Cascade)
 companyId String
 company ProspectCompany @relation(fields:[companyId],references:[id],onDelete:Cascade)
 createdBy String
 creator User @relation(fields:[createdBy],references:[id])
 recipientEmail String
 senderEmail String
 subject String
 body String
 provider String @default("resend")
 providerMessageId String? @unique
 requestKey String
 status String @default("SENDING")
 error String?
 sentAt DateTime?
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 events OutreachEmailEvent[]
 unsubscribeToken OutreachUnsubscribeToken?
 @@unique([organizationId,requestKey])
 @@index([organizationId,createdAt])
 @@index([draftId,createdAt])
 @@index([recipientEmail,status])
}
model OutreachEmailEvent {
 id String @id @default(cuid())
 providerEventId String @unique
 providerMessageId String
 eventType String
 occurredAt DateTime?
 sendId String?
 send OutreachSend? @relation(fields:[sendId],references:[id],onDelete:SetNull)
 receivedAt DateTime @default(now())
 @@index([providerMessageId,receivedAt])
}
model EmailSuppression {
 id String @id @default(cuid())
 organizationId String
 organization Organization @relation(fields:[organizationId],references:[id],onDelete:Cascade)
 email String
 reason String
 source String
 createdAt DateTime @default(now())
 @@unique([organizationId,email])
 @@index([organizationId,createdAt])
}
model OutreachUnsubscribeToken {
 id String @id @default(cuid())
 sendId String @unique
 send OutreachSend @relation(fields:[sendId],references:[id],onDelete:Cascade)
 tokenHash String @unique
 usedAt DateTime?
 createdAt DateTime @default(now())
}
model AuditLog {
 id String @id @default(cuid())
 organizationId String
 organization Organization @relation(fields:[organizationId],references:[id])
 userId String
 action String
 entityId String
 detail Json
 createdAt DateTime @default(now())
 @@index([organizationId,createdAt])
}
model ProductPackage {
 id String @id @default(cuid())
 organizationId String
 organization Organization @relation(fields:[organizationId],references:[id])
 name String
 price Decimal @db.Decimal(14,2)
 fromPrice Boolean @default(false)
 currency String @default("USD")
 @@unique([organizationId,name])
}

model Proposal {
 id String @id @default(cuid())
 organizationId String
 organization Organization @relation(fields:[organizationId],references:[id],onDelete:Cascade)
 companyId String
 company ProspectCompany @relation(fields:[companyId],references:[id],onDelete:Cascade)
 createdBy String
 creator User @relation(fields:[createdBy],references:[id])
 title String
 summary String @default("")
 objectives String @default("")
 confirmedChallenges String @default("")
 scope String @default("")
 deliverables String @default("")
 phases String @default("")
 timeline String @default("")
 paymentMilestones String @default("")
 hostingMaintenance String @default("")
 exclusions String @default("")
 terms String @default("")
 status String @default("DRAFT")
 items ProposalLineItem[]
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 @@index([organizationId,createdAt])
 @@index([companyId,createdAt])
}

model ProposalLineItem {
 id String @id @default(cuid())
 proposalId String
 proposal Proposal @relation(fields:[proposalId],references:[id],onDelete:Cascade)
 description String
 quantity Int
 unitPrice Decimal @db.Decimal(14,2)
 sortOrder Int
 @@index([proposalId,sortOrder])
}
model BusinessProfile {
 id String @id @default(cuid())
 organizationId String @unique
 organization Organization @relation(fields:[organizationId],references:[id],onDelete:Cascade)
 website String
 summary String @default("")
 services Json @default("[]")
 segments Json @default("[]")
 pages Json @default("[]")
 status String @default("ANALYSING")
 error String?
 active Boolean @default(true)
 analysedAt DateTime?
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
}
